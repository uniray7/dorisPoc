# Per-VM Nomad server values. Copy to node.hcl and edit; `make init` does this for you.
#
# Scaling out to 3 VMs: bootstrap_expect = 3 and all three addresses in retry_join,
# on every VM.

name = "vm1"

advertise {
  http = "10.140.0.4"
  rpc  = "10.140.0.4"
  serf = "10.140.0.4"
}

server {
  bootstrap_expect = 1

  server_join {
    retry_join = []
  }
}
